# Copie para .env e preencha. O .env nunca vai para o git.
# Valores abaixo são exemplos para desenvolvimento local, não segredos reais.

# Gere uma chave nova com:
#   venv/bin/python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Em produção fica true (padrão). Em desenvolvimento, sem HTTPS, false.
DJANGO_SECURE_SSL_REDIRECT=false

# Banco PostgreSQL exclusivo do IBC Gestão
DB_NAME=ibc_gestao
DB_USER=ibc_dev
DB_PASSWORD=troque-esta-senha
DB_HOST=localhost
DB_PORT=5432

# E-mail (recuperação de senha). Sem configurar, o e-mail aparece no terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=IBC Gestão <nao-responda@localhost>
